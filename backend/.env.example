# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-this

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/women_safety?retryWrites=true&w=majority

# Firebase — path to your service account JSON file
FIREBASE_CREDENTIALS=firebase-credentials.json

# Google Maps API key (for directions & places)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Twilio (optional — leave blank to use mock SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
